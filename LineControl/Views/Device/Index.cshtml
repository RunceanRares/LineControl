<script>
  $(document).ready(function () {
    $(".expandable-grid").on("click", ".expand-row", function () {
      var $icon = $(this);
      var deviceId = $icon.data("id");
      var $row = $icon.closest("tr");
      if ($icon.hasClass("k-i-expand")) {
        $row.after(`
                      <tr class="detail-row">
                          <td colspan="${$row.find("td").length}">
                              <div id="treelist_${deviceId}"></div>
                          </td>
                      </tr>
                  `);

        $("#treelist_" + deviceId).kendoTreeList({
          dataSource: {
            transport: {
              read: {
                url: "/Device/GetHierarchy",
                data: { parentId: deviceId}
                }
              },
              schema: {
                model:{
                  id: "Id",
                  parentId: "ParentId",
                  fields: {
                    Id: { type: "number" },
                    ParentId: { type: "number" },
                    ItemNumber: { type: "string" }
                  }
                }
              }
          },
            columns: [
              { field: "ItemNumber", title: "Item Number", width: "200px" },
            ],
            sortable: true,
            filterable: true,
            pageable: true
        });
        $icon.removeClass("k-i-expand").addClass("k-i-collapse");
      } else {
        $row.next(".detail-row").remove();
        $icon.removeClass("k-i-collapse").addClass("k-i-expand");
      }
    })
  })
</script>