@model ActivityTypeViewModel

@{
  var isEdit = Model != null && Model.Id != 0;
  ViewData["Title"] = isEdit ? "Edit Activity" : "Add Activity";
}

<div class="row s-pageTitle">
  <div class="col">
    <h2>@(isEdit ? "Edit Activity" : "Add Activity")</h2>
  </div>
</div>

<div class="container mt-4">
  <div class="card">
    <div class="card-body">
    @using (Html.BeginForm(isEdit ? "Edit" : "Create", "ActivityType", FormMethod.Post, new { @class = "ControllForm" }))
    { 
      @Html.AntiForgeryToken()
      <div class="s-formContent row justify-content-md-center ">
        <div class="form-row form-group">
          <div class="col s-paddingBtn">
            <button class="btn btn-primary s-button" type="submit"><i class='k-icon @(isEdit ? "k-i-save" : "k-i-add")'></i><span>@(isEdit ? "Save" : "Add")</span></button>
            <button class="btn btn-danger s-button s-CancelBtn" data-request-url="@Url.Action("Index", "ActivityType")"><i class='k-icon k-i-cancel'></i><span> Cancel</span></button>
          </div>
        </div>
        <div class="col-md-12 bg-light">
          <div class="form-row form-group">
            <div class="col-12">
              <label class="s-label" asp-for="@Model.CostCenter">Cost Center</label>
            </div>
            <div class="col-12">
              @(Html.Kendo().TextAreaFor(m => m.CostCenter)
                  .HtmlAttributes(new { @class = "s-customTextArea" })
                  .Rows(1).Deferred(true)
                  )
            </div>
            <div class="col-12">
              <label class="s-label" asp-for="@Model.Code">Code</label>
            </div>
            <div class="col-12">
              @(Html.Kendo().TextAreaFor(m => m.Code)
                  .HtmlAttributes(new { @class = "s-customTextArea" })
                  .Rows(1).Deferred(true)
                  )
            </div> 
            <div class="col-12">
              <label class="s-label" asp-for="@Model.Name">Name</label>
            </div>
            <div class="col-12">
              @(Html.Kendo().TextAreaFor(m => m.Name)
                  .HtmlAttributes(new { @class = "s-customTextArea" })
                  .Rows(1).Deferred(true)
                  )
            </div>
            <div class="col-12">
              <label class="s-label" asp-for="@Model.PassiveCostFactor">Passive Cost Factor</label>
            </div>
            <div class="col-12">
              @(Html.Kendo().TextAreaFor(m => m.PassiveCostFactor)
                  .HtmlAttributes(new { @class = "s-customTextArea" })
                  .Rows(1).Deferred(true)
                  )
            </div>
            <div class="col-12">
              <label class="s-label" asp-for="@Model.Rate">Rate</label>
            </div>
            <div class="col-12">
              @(Html.Kendo().TextAreaFor(m => m.Rate)
                  .HtmlAttributes(new { @class = "s-customTextArea" })
                  .Rows(1).Deferred(true)
                  )
            </div>
          </div>
        </div>
      </div>
    }
    </div>
  </div>
</div>