@using LineControllerCore.Models
@model DeviceCalibrationOrderViewModel

@{
  ViewData["Title"] = "Add Device Calibration";
}

<div class="row s-pageTitle">
  <div class="col">
    <h2>Add Device Calibration</h2>
  </div>
</div>

<div class="container mt-4">
  <div class="card">
    <div class="card-body">
      @using(Html.BeginForm("Create", "CalibrationOrder", FormMethod.Post, new { @class = "ControllForm" }))
      {
        @Html.AntiForgeryToken()
        <div class="s-formContent row justify-content-md-center">
          <div class="form-row form-group">
            <div class="form-row form-group">
              <div class="col s-paddingBtn">
                <button class="btn btn-primary s-button" type="submit"><i class='k-icon k-i-add'></i> <span>Add</span></button>
                <button class="btn btn-danger s-button s-CancelBtn" data-request-url="@Url.Action("Index", "CalibrationOrder")"><i class='k-icon k-i-cancel'></i> <span> Cancel</span></button>
              </div>
            </div>
          </div>
          <div class="col-md-12 bg-light">
            <div class="row">
              <!-- Coloana 1 -->
                <div class="col-md-6">
                  <div class="form-row form-group">
                    <div class="col-12">
                      <label class="s-label" asp-for="@Model.ItemNumber">Item Number</label>
                    </div>
                    <div class="col-12">
                    @(Html.Kendo().DropDownListFor(m => m.DeviceId)
                        .DataTextField("ItemNumber")
                        .DataValueField("Id")
                        .HtmlAttributes(new { @class = "s-customTextArea" })
                        .DataSource(source => source.Read(read =>
                        {
                          read.Action("GetItemNumber", "CalibrationOrder");
                        }))
                        .OptionLabel("Select a device...")
                        .AutoBind(true)
                        .Events(e => e
                          .Change("onDeviceChange")    
                          )
                        .Deferred()
                        )
                    </div>
                  </div>
                  <div class="form-row form-group">
                    <div class="col-12">
                      <label class="s-label" asp-for="@Model.CreatedBy">CreatedBy</label>
                    </div>
                    <div class="col-12">
                      @(Html.Kendo().TextAreaFor(m => m.CreatedBy)
                          .HtmlAttributes(new { @class = "s-customTextArea" })
                          .Rows(1).Deferred(true)
                          )
                    </div>
                  </div>
                  <div class="form-row form-group">
                    <div class="col-12">
                      <label class="s-label" asp-for="@Model.Status">Status</label>
                    </div>
                    <div class="col-12">
                      @(Html.Kendo().DropDownListFor(m => m.StatusId)
                          .HtmlAttributes(new { @class = "s-device-status" })
                          .DataTextField("Name")
                          .DataValueField("Id")
                          .DataSource(dataSource => dataSource.Read(read =>
                          {
                            read.Action("GetAllDeviceStatuses", "Device");
                          }))
                          .AutoBind(true)
                          .Deferred()
                          )
                    </div>
                  </div>
                  <div class="form-row form-group">
                    <div class="col-12">
                      <label class="s-label" asp-for="@Model.AccountingNumber">Accounting Number</label>
                    </div>
                    <div class="col-12">
                      @(Html.Kendo().TextAreaFor(m => m.AccountingNumber)
                          .HtmlAttributes(new { @class = "s-customTextArea" })
                          .Rows(1).Deferred(true)
                          )
                    </div>
                  </div>
                    <div class="form-row form-group">
                      <div class="col-12">
                    <label class="s-label" asp-for="TestLocation">TestLocation</label>
                      </div>                        
                      <div class="col-12">
                    @(Html.Kendo().TextAreaFor(m => m.TestLocation)
                              .HtmlAttributes(new { @class = "s-customTextArea" })
                              .Deferred(true)
                            )
                      </div>
                    </div>
                <div class="form-row form-group">
                  <div class="col-12">
                    <label class="s-label" asp-for="AccountingType">Accounting Type</label>
                  </div>
                  <div class="col-12">
                    @(Html.Kendo().DropDownListFor(m => m.AccountingType)
                        .BindTo(Enum.GetValues(typeof(LineControllerInfrastructure.Entities.Enums.AccountingType))
                        .Cast<LineControllerInfrastructure.Entities.Enums.AccountingType>()
                        .Select(e => new SelectListItem
                        {
                          Text = e.ToString(),
                          Value = ((int)e).ToString()
                        }))
                        .OptionLabel("Select accounting type...")
                        .HtmlAttributes(new { @class = "s-customTextArea" })
                        .Deferred(true)
                    )
                  </div>
                </div>
                </div>
              <!-- Coloana 2 -->
            <div class="col-md-6">
              <div class="form-row form-group">
                <div class="col-12">
                    <label class="s-label" asp-for="@Model.ActionId">Action</label>
                </div>
                <div class="col-12">
                    @(Html.Kendo().DropDownListFor(m => m.ActionId)
                        .HtmlAttributes(new { @class = "s-device-action" })
                        .DataTextField("Name")
                        .DataValueField("Id")
                        .OptionLabel("Select a action...")
                        .DataSource(dataSource => dataSource.Read(read =>
                        {
                          read.Action("GetCalibrationAction", "CalibrationOrder");
                        }))
                        .AutoBind(true)
                        .Deferred()
                        )
                </div>
              </div>
              <div class="form-row form-group">
                <div class="col-12">
                  <label class="s-label" asp-for="@Model.Inspector">Inspector</label>
                </div>
                <div class="col-12">
                  @(Html.Kendo().TextArea().Name("InspectorTextArea").Value(User.Identity.Name)
                        .HtmlAttributes(new { @class = "s-customTextArea" }))
                </div>
              </div>
              <div class="form-row form-group">
                <div class="col-12">
                  <label class="s-label" asp-for="@Model.Comment">Comment</label>
                </div>
                <div class="col-12">
                  @(Html.Kendo().TextAreaFor(m => m.Comment)
                      .HtmlAttributes(new { @class = "s-customTextArea" })
                      .Rows(1).Deferred(true)
                      )
                </div>
              </div>
              <div class="form-row form-group">
                <div class="col-12">
                  <label class="s-label" asp-for="@Model.CalibrationLocation">Calibration Location</label>
                </div>
                <div class="col-12">
                  @(Html.Kendo().DropDownListFor(m => m.CalibrationLocationId)
                      .HtmlAttributes(new { @class = "s-device-location" })
                      .DataTextField("Name")
                      .DataValueField("Id")
                      .DataSource(dataSource => dataSource.Read(read =>
                      {
                        read.Action("GetAllDeviceLocation", "CalibrationOrder");
                      }))
                      .AutoBind(true)
                      .Deferred()
                      )
                </div>
              </div>
                <div class="form-row form-group">
                  <div class="col-12">
                    <label class="s-label" asp-for="@Model.ReceiverId">Receiver</label>
                  </div>
                  <div class="col-12">
                    @(Html.Kendo().DropDownListFor(m => m.ReceiverId)
                        .HtmlAttributes(new { @class = "s-device-user" })
                        .DataTextField("Display")
                        .DataValueField("Id")
                        .DataSource(dataSource => dataSource.Read(read =>
                        {
                          read.Action("GetUserCalibration", "CalibrationOrder");
                        }))
                        .AutoBind(true)
                        .Deferred()
                        )
                  </div>
                </div>
                <div class="form-row form-group">
                  <div class="col-12">
                    <label class="s-label" asp-for="@Model.NoChannels">NoChannels</label>
                  </div>
                  <div class="col-12">
                    @(Html.Kendo().TextAreaFor(m => m.NoChannels)
                        .HtmlAttributes(new { @class = "s-customTextArea" })
                        .Rows(1).Deferred(true)
                        )
                  </div>
                </div>
             </div>
          </div>
          </div>
        </div>
      }
    </div>
  </div>
</div>