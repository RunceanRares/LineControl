@using LineControllerCore.Models
@model DeviceCalibrationOrderViewModel

@{
  ViewData["Title"] = "Edit Device Calibration";
}

<div class="row s-pageTitle">
  <div class="col">
    <h2>Edit Device Calibration</h2>
  </div>
</div>

<div class="container mt-4">
  <div class="card">
    <div class="card-body">
      @using (Html.BeginForm ("Edit", "CalibrationOrder", FormMethod.Post, new { @class = "ControllForm" }))
      {
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id">
        <div class="s-formContent row justify-content-md-center">
          <div class="form-row form-group">
            <div class="form-row form-group">
              <div class="col s-paddingBtn">
                <button class="btn btn-primary s-button" type="submit"><i class='k-icon k-i-save'></i> <span>Save</span></button>
                <button class="btn btn-danger s-button s-CancelBtn" data-request-url="@Url.Action("Index", "CalibrationOrder")"><i class='k-icon k-i-cancel'></i> <span> Cancel</span>
              </div>
            </div>
          </div>
          <div class="col-md-12 bg-light">
            <div class="row">
              <!-- Coloana 1 -->
              <div class="col-md-6">
                <div class="form-row form-group">
                  <div class="col-12">
                    <label class="s-label" asp-for="@Model.ItemNumber">ItemNumber</label>
                  </div>
                  <div class="col-12">
                    @(Html.Kendo().TextAreaFor(m => m.ItemNumber)
                        .HtmlAttributes(new { @class = "s-customTextArea" })
                        .Rows(1).Deferred(true))
                  </div>
                </div>
                <div class="form-row form-group">
                  <div class="col-12">
                    <label class="s-label" asp-for="@Model.Inspector">Inspector</label>
                  </div>
                  <div class="col-12">
                    @(Html.Kendo().TextAreaFor(m => m.Inspector)
                        .HtmlAttributes(new { @class = "s-customTextArea" })
                        .Rows(1).Deferred(true))
                  </div>
                </div>
                <div class="form-row form-group">
                  <div class="col-12">
                    <label class="s-label" asp-for="@Model.Status">Status</label>
                  </div>
                  <div class="col-12">
                    @(Html.Kendo().DropDownListFor(m => m.StatusId)
                        .HtmlAttributes(new { @class = "s-device-status" })
                        .DataTextField("Name")
                        .DataValueField("Id")
                        .DataSource(dataSource => dataSource.Read(read =>
                        {
                          read.Action("GetAllDeviceStatuses", "Device");
                        }))
                        .AutoBind(true)
                        .Deferred()
                        )
                  </div>
                </div>
                <div class="form-row form-group">
                  <div class="col-12">
                    <label class="s-label" asp-for="@Model.CalibrationDate">Calibration Date</label>
                  </div>
                  <div class="col-12">
                    @(Html.Kendo().DateTimePickerFor(m => m.CalibrationDate)
                        .HtmlAttributes(new { @class = "s-customTextArea" })
                        .Deferred()
                        )
                  </div>
                </div>
                <div class="form-row form-group">
                  <div class="col-12">
                    <label class="s-label" asp-for="@Model.CalibrationResult">Calibration Result</label>
                  </div>
                  <div class="col-12">
                    @(Html.Kendo().TextAreaFor(m => m.CalibrationResult)
                        .HtmlAttributes(new { @class = "s-customTextArea" })
                        .Deferred()
                        )
                  </div>
                </div>
              </div>
              <!-- Coloana 2 -->
              <div class="col-md-6">
                <div class="form-row form-group">
                  <div class="col-12">
                    <label class="s-label" asp-for="@Model.AccountingNumber">Accounting Number</label>
                  </div>
                  <div class="col-12">
                    @(Html.Kendo().TextAreaFor(m => m.AccountingNumber)
                        .HtmlAttributes(new { @class = "s-customTextArea" })
                        .Rows(1).Deferred(true))
                  </div>
                </div>
                <div class="form-row form-group">
                  <div class="col-12">
                    <label class="s-label" asp-for="@Model.Action">Action</label>
                  </div>
                  <div class="col-12">
                    @(Html.Kendo().TextAreaFor(m => m.Action)
                        .HtmlAttributes(new { @class = "s-customTextArea" })
                        .Rows(1).Deferred(true))
                  </div>
                </div>
                <div class="form-row form-group">
                  <div class="col-12">
                    <label class="s-label" asp-for="@Model.Comment">Comment</label>
                  </div>
                  <div class="col-12">
                    @(Html.Kendo().TextAreaFor(m => m.Comment)
                        .HtmlAttributes(new { @class = "s-customTextArea" })
                        .Rows(1).Deferred(true))
                  </div>
                </div>
                <div class="form-row form-group">
                  <div class="col-12">
                    <label class="s-label" asp-for="@Model.CalibrationInterval">Calibration Interval</label>
                  </div>
                  <div class="col-12">
                    @(Html.Kendo().TextAreaFor(m => m.CalibrationInterval)
                        .HtmlAttributes(new { @class = "s-customTextArea" })
                        .Rows(1).Deferred(true))
                  </div>
                </div>
                @if (Model.Edited)
                {
                  <div class="form-row form-group">
                    <div class="col-12">
                      <label class="s-label" asp-for="@Model.CalibrationLocation">Calibration Location</label>
                    </div>
                    <div class="col-12">
                      @(
                        Html.Kendo().DropDownListFor(m => m.CalibrationLocation)
                        .HtmlAttributes(new { @class = "s-device-location" })
                        .DataTextField("Name")
                        .DataValueField("Id")
                        .DataSource(dataSource => dataSource.Read(read =>
                        {
                          read.Action("GetAllDeviceLocation", "CalibrationOrder");
                        }))
                        .AutoBind(true)
                        .Deferred()
                        )
                    </div>
                  </div>
                }
                else
                {
                  <div class="form-row form-group">
                    <div class="col-12">
                      <label class="s-label" asp-for="@Model.CalibrationLocation">Calibration Location</label>
                    </div>
                    <div class="col-12">
                      @(
                          Html.Kendo().DropDownListFor(m => m.CalibrationLocation)
                          .HtmlAttributes(new { @class = "s-device-location", disabled = "disabled" })
                          .DataTextField("Name")
                          .DataValueField("Id")
                          .DataSource(dataSource => dataSource.Read(read =>
                          {
                            read.Action("GetAllDeviceLocation", "CalibrationOrder");
                          }))
                          .AutoBind(true)
                          .Deferred()
                          )
                    </div>
                  </div>
                }
              </div>
            </div>
          </div>
        </div>
      }
    </div>
  </div>
</div>