@using LineControllerCore.Model
@model CompanyLocationViewModel
@{
  var isEdit = Model.Id;
  ViewData["Title"] = isEdit > 0 ? "Edit Company Location" : " Add Company";
}

<div class="row s-pageTitle">
  <div class="col">
    @if (isEdit > 0)
      {
        <h1>Edit Company Location</h1>
      }
      else
      {
        <h1>Add Company Location</h1>
      }
  </div>
</div>
<div class="container mt-4">
  <div class="card">
    @using (Html.BeginForm(isEdit > 0 ? "Edit" : "Create", "CompanyLocation", FormMethod.Post, new { @class = "ControllForm"}))
    { 
      @Html.AntiForgeryToken()
      <div class="s-formContent row justify-content-md-center ">
        <div class="form-row form-group">
          <div class="col s-paddingBtn">
            <button class="btn btn-primary s-button" type="submit"><i class='k-icon @(Model.Id > 0 ? "k-i-save" : "k-i-add")'></i><span>@(Model.Id > 0 ? "Save" : "Add")</span></button>
            <button class="btn btn-danger s-button s-CancelBtn" data-request-url="@Url.Action("Index", "CompanyLocation")"><i class='k-icon k-i-cancel'></i><span> Cancel</span></button>
          </div>
        </div>
        @if (isEdit == 0)
        {
          <div class="row mb-3">
            <label class="col-md-8 col-form-label" asp-for="@Model.Code" style="font-weight:bold" c>Code</label>
            <div class="col-md-12">
              @Html.EditorFor(m => m.Code)
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-md-8 col-form-label" asp-for="@Model.Name" style="font-weight:bold"></label>
            <div class="col-md-12">
              @Html.EditorFor(m => m.Name)
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-md-8 col-form-label" asp-for="@Model.Country" style="font-weight:bold"></label>
          <div class="col-md-12">
            @Html.EditorFor(m => m.Country)
          </div>
          </div>
        }
        else
        {
          <div class="row mb-3">
            <label class="col-md-8 col-form-label" asp-for="@Model.Code" style="font-weight:bold">Code</label>
            <div class="col-md-12">
              @Html.EditorFor(m => m.Code, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-md-8 col-form-label" asp-for="@Model.Name" style="font-weight:bold"></label>
            <div class="col-md-12">
              @Html.EditorFor(m => m.Name)
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-md-8 col-form-label" asp-for="@Model.Country" style="font-weight:bold"></label>
            <div class="col-md-12">
              @Html.EditorFor(m => m.Country, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
            </div>
          </div>
        }
       </div>
    }
  </div>
</div>